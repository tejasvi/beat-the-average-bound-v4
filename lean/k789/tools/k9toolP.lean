import BeatAvg.Data.K8.Trees
import BeatAvg.Data.K9.Blocks
import BeatAvg.Core.Hier9P
open BeatAvg.Check

def showArr (a : Array Nat) : String := "#[" ++ ", ".intercalate (a.toList.map toString) ++ "]"

def main (args : List String) : IO Unit := do
  let out := args.headD "Extra.lean"
  let t0 ← IO.monoMsNow
  let (S, core, bad) := k9genP BeatAvg.Data.K8.levels BeatAvg.Data.K9.lower BeatAvg.Data.K9.mid BeatAvg.Data.K9.top
    BeatAvg.Data.K9.excl8 BeatAvg.Data.K9.lamN BeatAvg.Data.K9.lamD BeatAvg.Data.K9.capN BeatAvg.Data.K9.capD
    BeatAvg.Data.K9.den7 BeatAvg.Data.K9.qscale
  let t1 ← IO.monoMsNow
  IO.println s!"S {S.size} core {core.size} above-cap-unexcluded {bad} time {t1 - t0} ms"
  let lines := #["import BeatAvg.Core.Hier9", "",
    "/-! The lists `S` (8-tuples with f8 above 9 λ - 8 cap) and `core` (patterns of the top flags with their tuples) of",
    "the certificate with 9 points, generated by scratch/t/k9toolP.lean (BeatAvg.Check.k9genP). They are checked by",
    "`checkK9` and not trusted. -/", "", "set_option maxRecDepth 100000", "set_option maxHeartbeats 0", "",
    "namespace BeatAvg.Data.K9", "",
    "def S : Array (Array Nat) := #[\n  " ++ ",\n  ".intercalate (S.toList.map showArr) ++ "]", "",
    "def core : Array (Nat × Array Nat) := #[\n  " ++
      ",\n  ".intercalate (core.toList.map fun e => s!"({e.1}, {showArr e.2})") ++ "]", "",
    "end BeatAvg.Data.K9", ""]
  IO.FS.writeFile out ("\n".intercalate lines.toList)
  IO.println s!"wrote {out}"
