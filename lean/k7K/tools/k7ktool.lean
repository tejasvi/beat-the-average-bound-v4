import BeatAvg.Data.K7
import BeatAvg.Core.K7K
import BeatAvg.Core.Hier9
open BeatAvg.Check

/-! Generator of the kernel tables for k = 7 (untrusted: every entry is checked in the kernel). -/

def bitlen (n : Nat) : Nat := Nat.log2 n + 1

def packF (w : Nat) (l : List Nat) : Nat := l.foldr (fun a acc => a + 2 ^ w * acc) 0

partial def treeStr (depth : Nat) (leaf : Nat → Nat) (pfx : String) (out : IO.FS.Handle) : IO String := do
  -- writes subtrees of depth `depth - 6` as separate definitions; returns the top expression
  let lvl := if depth > 6 then depth - 6 else 0
  let rec build (d i : Nat) : String :=
    if d == 0 then s!"(.leaf {leaf i})" else s!"(.node {build (d - 1) (2 * i)} {build (d - 1) (2 * i + 1)})"
  for i in [0:2 ^ (depth - lvl)] do
    out.putStrLn s!"def {pfx}{i} : KT := {build lvl i}"
  let rec top (d i : Nat) : String :=
    if d == 0 then s!"{pfx}{i}" else s!"(.node {top (d - 1) (2 * i)} {top (d - 1) (2 * i + 1)})"
  return top (depth - lvl) 0

def main (args : List String) : IO Unit := do
  let outFn := args.headD "K7K.lean"
  let blocks := BeatAvg.Data.K7.blocks
  let low := blocks.filter fun b => decide (2 * b.m - b.t ≤ 6)
  let top := blocks.filter fun b => b.t == 5 && b.m == 6
  let one := blocks.filter fun b => b.t == 1 && b.m == 4
  IO.println s!"blocks {blocks.length}: low {low.length}, top {top.length}, one {one.length}"
  let qscale := BeatAvg.Data.K7.qscale
  -- den6 = lcm (60, D 6 b * qscale for low)
  let den6 := low.foldl (fun d b => Nat.lcm d (b.D 6 * qscale)) 60
  let d14 := (one.headD dfltB).D 7
  let lvs := BeatAvg.Data.K7.levels
  let P6 := (chainList [0] (lvs.take 3)).toArray
  let s6l := (P6.toList.mergeSort (· ≤ ·))
  let n6 := s6l.length
  IO.println s!"n6 {n6}, den6 {den6}, d14 {d14}"
  let lk6 := tupList 6
  let f6l := s6l.map fun x => valNum 6 lk6 low den6 qscale x
  let mx6 := f6l.foldl (fun m v => max m v.natAbs) 0
  let w6 := bitlen mx6 + 2
  let off6 := 2 ^ (w6 - 1)
  let f6 := packF w6 (f6l.map fun v => (v + (off6 : Int)).toNat)
  -- top lists: for each 6-pattern number q, entries (p, blk, i)
  let s6a := s6l.toArray
  let mut tl : Array (List (Nat × Nat × Nat)) := Array.replicate n6 []
  for blk in [0:top.length] do
    let fl := (top.getD blk dfltB).flags
    for i in [0:fl.length] do
      let f := fl.getD i (0, 0)
      match s6a.findIdx? (· == f.1) with
      | none => pure ()
      | some q =>
        for p in [0:6] do
          if f.2 == maskExcept 6 p then tl := tl.modify q (fun l => l ++ [(p, blk, i)])
  let maxc := tl.foldl (fun m l => max m l.length) 0
  IO.println s!"top lists: max {maxc}, total {tl.foldl (fun m l => m + l.length) 0}"
  let topLeaf := fun q => if q < n6 then
      let l := tl.getD q []
      l.length + 4096 * packF 28 (l.map fun e => e.1 + 16 * e.2.1 + 65536 * e.2.2)
    else 0
  -- matrix rows
  let mxq := top.foldl (fun m b => (List.range b.flags.length).foldl (fun m i =>
    (qrowList b i).foldl (fun m v => max m v.natAbs) m) m) 0
  let wq := bitlen mxq + 2
  let offq := 2 ^ (wq - 1)
  IO.println s!"w6 {w6}, wq {wq}"
  let h ← IO.FS.Handle.mk outFn .write
  h.putStrLn "import BeatAvg.Core.K7K\n"
  h.putStrLn "/-! Kernel tables for the certificate with 7 points (generated by scratch/t/k7ktool.lean; checked in the kernel,\nnot trusted). -/\n"
  h.putStrLn "set_option maxRecDepth 100000\nset_option maxHeartbeats 0\n\nnamespace BeatAvg.Data.K7K\nopen BeatAvg.Check\n"
  h.putStrLn s!"def n6 : Nat := {n6}\ndef s6 : Nat := {packF 60 s6l}\ndef w6 : Nat := {w6}\ndef f6 : Nat := {f6}"
  let topE ← treeStr 11 topLeaf "tp" h
  h.putStrLn s!"def topT : KT := {topE}"
  let mut qnames : Array String := #[]
  for blk in [0:top.length] do
    let b := top.getD blk dfltB
    let rowLeaf := fun i => if i < b.flags.length then packF wq ((qrowList b i).map fun v => (v + (offq : Int)).toNat) else 0
    let e ← treeStr 9 rowLeaf s!"q{blk}_" h
    h.putStrLn s!"def qr{blk} : KT := {e}"
    qnames := qnames.push s!"qr{blk}"
  h.putStrLn s!"def wq : Nat := {wq}"
  h.putStrLn s!"def qrows : List KT := [{", ".intercalate qnames.toList}]"
  -- the block (1,4)
  let ob := one.headD dfltB
  let ft14 := packF 4 ((List.range 256).map fun key =>
    match lookupIdx ob.flags (key % 16, key / 16) with | some i => i + 1 | none => 0)
  let n14 := ob.flags.length
  let qv := (List.range n14).flatMap fun i => (List.range n14).map fun j => ob.qint i j
  let wq14 := bitlen (qv.foldl (fun m v => max m v.natAbs) 0) + 2
  let off14 := 2 ^ (wq14 - 1)
  let q14 := packF wq14 (qv.map fun v => (v + (off14 : Int)).toNat)
  h.putStrLn s!"def ft14 : Nat := {ft14}\ndef n14 : Nat := {n14}\ndef wq14 : Nat := {wq14}\ndef q14 : Nat := {q14}"
  h.putStrLn "def tab : K7Tab := ⟨n6, s6, w6, f6, topT, wq, qrows, ft14, n14, wq14, q14⟩"
  h.putStrLn s!"def den6 : Nat := {den6}\ndef d14 : Nat := {d14}"
  h.putStrLn "end BeatAvg.Data.K7K"
  h.flush
  IO.println s!"wrote {outFn}"
